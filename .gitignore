# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Virtual environments / dependency installs (defense-in-depth;
# individual model-context-protocol-servers/* already gitignore their own .venv/)
.venv/
venv/
node_modules/

# Machine-local MCP server config — generated from .mcp.json.example by the SessionStart
# mcp-config-platform-check.py hook (per-OS interpreter path is not portable across machines).
.mcp.json

# Progress-tracking files at any depth are ignored; monitoring templates stay tracked. IDE folder ignored.
progress.md
session-log.md
checkpoint.json
!**/templates/monitoring/*
.idea/
