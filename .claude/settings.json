{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-quality-gate.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-optimizer.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/pipeline-context-injector.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-budget-alert.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/retrieval-augmented-generation-freshness-flag.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/harness-rate-limiter-turn-reset.py"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-gate-enforcer.py"]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/harness-tool-rate-limiter.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/multi-agent-branch-naming-guard.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/multi-agent-commit-format-guard.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/system-shell-syntax-guard.py"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-line-encoding-validator.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-gate-clear.py"]
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag-index-sync.py"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/harness-error-boundary-monitor.py"]
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enabledMcpjsonServers": [
    "workspace-knowledge",
    "agent-memory"
  ],
  "permissions": {
    "allow": [
      "mcp__workspace-knowledge__search_docs",
      "mcp__workspace-knowledge__retrieve_context",
      "mcp__workspace-knowledge__list_indexed_files",
      "mcp__workspace-knowledge__rebuild_index",
      "mcp__workspace-knowledge__upsert_document",
      "mcp__workspace-knowledge__summarize_context",
      "mcp__workspace-knowledge__check_adr_precedent",
      "mcp__workspace-knowledge__validate_pipeline_document",
      "mcp__workspace-knowledge__find_related_documents",
      "mcp__workspace-knowledge__list_research_by_topic",
      "mcp__workspace-knowledge__agent_knowledge_brief",
      "mcp__workspace-knowledge__health_check",
      "mcp__agent-memory__search_memory",
      "mcp__agent-memory__health_check"
    ]
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
